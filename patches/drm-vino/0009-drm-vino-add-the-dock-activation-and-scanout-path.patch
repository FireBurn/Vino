+        (1, 272),
+        (0, 277),
+        (1, 293),
+        (1, 303),
+    ],
+    remode: &[],
+    markers: &[
+        (7, 0, 0x2f, 1),
+        (13, 0, 0x2e, 3),
+        (20, 1, 0x2f, 1),
+        (21, 0, 0x2f, 1),
+        (35, 0, 0x2e, 0),
+        (76, 1, 0x2e, 3),
+        (104, 1, 0x2f, 1),
+        (128, 1, 0x2e, 3),
+        (131, 0, 0x2f, 1),
+        (136, 0, 0x2e, 0),
