From af27f5c5a0228b4e5a2ef4a6deafb6ddf3a024fc Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Mon, 27 Jul 2026 18:32:50 +0100
Subject: [PATCH 095/113] rust: workqueue: type owned queue allocation flags

Replace the raw integer flag mask accepted by OwnedQueue with a QueueFlags type. Drivers can now allocate queues with supported WQ_* policies without importing generated bindings.

Assisted-by: Claude:claude-opus-5-0
Assisted-by: Codex:gpt-5
Signed-off-by: Mike Lothian <mike@fireburn.co.uk>
---
 rust/kernel/workqueue.rs | 33 ++++++++++++++++++++++++++++-----
 1 file changed, 28 insertions(+), 5 deletions(-)

diff --git a/rust/kernel/workqueue.rs b/rust/kernel/workqueue.rs
index 1eba1f6d9363..8e8c0fddfca7 100644
--- a/rust/kernel/workqueue.rs
+++ b/rust/kernel/workqueue.rs
@@ -268,20 +268,43 @@ unsafe impl Send for OwnedQueue {}
 // SAFETY: Accesses to workqueues are thread-safe, exactly as for `Queue`.
 unsafe impl Sync for OwnedQueue {}
 
+/// Workqueue allocation flags.
+#[derive(Copy, Clone, Default)]
+pub struct QueueFlags(u32);
+
+impl QueueFlags {
+    /// Work items are not bound to a specific CPU.
+    pub const UNBOUND: Self = Self(bindings::wq_flags_WQ_UNBOUND);
+    /// Work items may be frozen during system suspend.
+    pub const FREEZABLE: Self = Self(bindings::wq_flags_WQ_FREEZABLE);
+    /// The queue participates in the memory-reclaim forward-progress guarantee.
+    pub const MEM_RECLAIM: Self = Self(bindings::wq_flags_WQ_MEM_RECLAIM);
+    /// Work items run at elevated priority.
+    pub const HIGHPRI: Self = Self(bindings::wq_flags_WQ_HIGHPRI);
+    /// Work items are CPU intensive and do not count towards concurrency management.
+    pub const CPU_INTENSIVE: Self = Self(bindings::wq_flags_WQ_CPU_INTENSIVE);
+}
+
+impl core::ops::BitOr for QueueFlags {
+    type Output = Self;
+
+    fn bitor(self, rhs: Self) -> Self::Output {
+        Self(self.0 | rhs.0)
+    }
+}
+
 impl OwnedQueue {
     /// Allocates a new workqueue named `name`.
     ///
     /// `max_active` bounds the number of work items that may execute concurrently per CPU; `0`
-    /// selects the kernel's default. `flags` is the usual `WQ_*` mask -- `WQ_UNBOUND` for work that
-    /// should be free to run on any CPU (which is what a compute fan-out wants), `WQ_FREEZABLE`,
-    /// `WQ_MEM_RECLAIM`, and so on.
+    /// selects the kernel's default.
     ///
     /// The name is copied by the C side into the workqueue's own storage, so `name` does not have
     /// to outlive this call.
-    pub fn new(name: &CStr, flags: u32, max_active: i32) -> Result<Self> {
+    pub fn new(name: &CStr, flags: QueueFlags, max_active: i32) -> Result<Self> {
         // SAFETY: `name` is a valid NUL-terminated C string for the duration of the call, and the
         // helper only formats it into the workqueue's own name storage.
-        let ptr = unsafe { bindings::alloc_workqueue(name.as_char_ptr(), flags, max_active) };
+        let ptr = unsafe { bindings::alloc_workqueue(name.as_char_ptr(), flags.0, max_active) };
         Ok(Self(NonNull::new(ptr).ok_or(ENOMEM)?))
     }
 }
