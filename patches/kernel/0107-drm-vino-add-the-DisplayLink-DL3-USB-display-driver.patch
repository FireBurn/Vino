+        let block = [16320i32; wht::BLOCK];
+        let c = wht::transform(&block);
+        assert_eq!(c[0], 16320);
+        assert!(c[1..].iter().all(|&x| x == 0));
+        // White pixel -> Y plane -> WHT DC -> quantized value.
