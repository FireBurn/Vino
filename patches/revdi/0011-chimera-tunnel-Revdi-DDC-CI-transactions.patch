From 1b7e5345656c8b44dd1eb0e6d1edcadf0ef36df3 Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Mon, 27 Jul 2026 23:21:25 +0100
Subject: [PATCH 11/13] chimera: tunnel Revdi DDC/CI transactions

Forward Revdi monitor-control writes through the dock's encrypted control channel and fetch the paired reply for reads. Reuse Vino's bounded decoder directly so the daemon and kernel driver share the wire format and payload validation.

Assisted-by: Claude:claude-opus-5-0
Assisted-by: Codex:gpt-5
Signed-off-by: Mike Lothian <mike@fireburn.co.uk>
---
 chimera/src/daemon.rs  | 13 +++++++-----
 chimera/src/kshim.rs   | 11 +++++-----
 chimera/src/kvino.rs   | 40 ++++++++++++++++++++++++++++++++++++
 chimera/src/session.rs | 30 +++++++++++++++++++++++++++
 chimera/vino/cp.rs     | 46 ++++++++++++++++++++++++++++++++++++++++++
 5 files changed, 130 insertions(+), 10 deletions(-)

diff --git a/chimera/src/daemon.rs b/chimera/src/daemon.rs
index 6dcf49f..c72172a 100644
--- a/chimera/src/daemon.rs
+++ b/chimera/src/daemon.rs
@@ -128,11 +128,14 @@ fn handle_event(
             )?;
         }
         DeviceEvent::CursorMove(_) => {}
-        DeviceEvent::Ddcci(_) => {
-            // Complete unsupported requests explicitly so the virtual I2C
-            // adapter never waits indefinitely. The control session gains the
-            // read path together with the kernel driver's DDC/CI reply parser.
-            output.card.ddcci_response(&[], false);
+        DeviceEvent::Ddcci(request) => {
+            match session.ddcci(output.head, request.address, request.flags, &request.buffer) {
+                Ok(response) => output.card.ddcci_response(&response, true),
+                Err(error) => {
+                    eprintln!("head {}: DDC/CI transaction failed: {error}", output.head);
+                    output.card.ddcci_response(&[], false);
+                }
+            }
         }
     }
     Ok(())
