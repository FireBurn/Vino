+/// One framebuffer prepared for repeated GRABPIX calls.
+pub(crate) struct PreparedScanout {
+    pub(crate) framebuffer: ARef<Framebuffer<EvdiDrmDriver>>,
+    pub(crate) mapping: FramebufferVMapOwned<EvdiObject>,
