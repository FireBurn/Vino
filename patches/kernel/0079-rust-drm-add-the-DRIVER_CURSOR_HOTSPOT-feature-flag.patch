From 636a714ce177dbd7f445aa4caf46d8904c9f4400 Mon Sep 17 00:00:00 2001
From: Mike Lothian <mike@fireburn.co.uk>
Date: Wed, 22 Jul 2026 20:56:52 +0100
Subject: [PATCH 079/113] rust: drm: add the DRIVER_CURSOR_HOTSPOT feature flag

Drivers whose hardware composites the cursor plane itself, rather than
blending it into the primary scanout, need the DRM core to expose the
HOTSPOT_X and HOTSPOT_Y cursor-plane properties so userspace can say where
within the bitmap the click point lies. Without them the pointer's active
point does not match where it is drawn.

This is the same feature the virtualised drivers use for their host-drawn
cursors. Add it as an opt-in associated constant, defaulting to off.

The consumer is the vino DisplayLink driver, whose dock draws the cursor
from a control-plane message rather than from the scanout buffer.

Assisted-by: Claude:claude-opus-5-0
Assisted-by: Codex:gpt-5
Signed-off-by: Mike Lothian <mike@fireburn.co.uk>
---
 rust/kernel/drm/device.rs |  4 ++++
 rust/kernel/drm/driver.rs | 14 ++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/rust/kernel/drm/device.rs b/rust/kernel/drm/device.rs
index bc2cdcd2b695..e4d806ae7d81 100644
--- a/rust/kernel/drm/device.rs
+++ b/rust/kernel/drm/device.rs
@@ -167,6 +167,10 @@ const fn compute_features() -> u32 {
             features |= drm::driver::FEAT_MODESET | drm::driver::FEAT_ATOMIC;
         }
 
+        if T::FEAT_CURSOR_HOTSPOT {
+            features |= drm::driver::FEAT_CURSOR_HOTSPOT;
+        }
+
         features
     }
 
diff --git a/rust/kernel/drm/driver.rs b/rust/kernel/drm/driver.rs
index 356be329a2b6..5276ca48c5f3 100644
--- a/rust/kernel/drm/driver.rs
+++ b/rust/kernel/drm/driver.rs
@@ -25,6 +25,9 @@
 /// The driver supports atomic modesetting.
 pub(crate) const FEAT_ATOMIC: u32 = bindings::drm_driver_feature_DRIVER_ATOMIC;
 
+/// The driver expects the cursor plane's hotspot properties to be maintained by userspace.
+pub(crate) const FEAT_CURSOR_HOTSPOT: u32 = bindings::drm_driver_feature_DRIVER_CURSOR_HOTSPOT;
+
 /// Information data for a DRM Driver.
 pub struct DriverInfo {
     /// Driver major version.
@@ -158,6 +161,17 @@ pub trait Driver {
     /// usable from the render node (i.e. marked DRM_RENDER_ALLOW), whereas
     /// userspace processes using the master node can invoke any ioctl.
     const FEAT_RENDER: bool = false;
+
+    /// Sets the `DRIVER_CURSOR_HOTSPOT` feature for this driver.
+    ///
+    /// Enable this for a driver whose hardware composites the cursor plane itself, rather than the
+    /// driver blending it into the primary scanout. The DRM core then exposes the `HOTSPOT_X` and
+    /// `HOTSPOT_Y` cursor-plane properties, and userspace tells the driver where within the cursor
+    /// bitmap the click point lies -- without which the pointer's active point does not match
+    /// where it is drawn.
+    ///
+    /// This is the same feature virtualised drivers use for their host-drawn cursors.
+    const FEAT_CURSOR_HOTSPOT: bool = false;
 }
 
 /// The registration type of a `drm::Device`.
